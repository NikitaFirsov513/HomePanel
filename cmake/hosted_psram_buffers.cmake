# Replace only the allocator definition in a generated copy of the pinned port.
# Its function table is in the same translation unit, so --wrap cannot override it.
function(home_panel_hosted_psram_buffers hosted_target)
    get_target_property(sources ${hosted_target} SOURCES)
    set(updated)
    set(count 0)
    foreach(source IN LISTS sources)
        get_filename_component(name "${source}" NAME)
        if(name STREQUAL "port_esp_hosted_host_os.c")
            math(EXPR count "${count}+1")
            file(READ "${source}" original)
            string(FIND "${original}" "void *hosted_malloc_align(size_t size, size_t align)" first)
            string(FIND "${original}" "void hosted_free_align(void* ptr)" last)
            if(first LESS 0 OR last LESS_EQUAL first)
                message(FATAL_ERROR "ESP-Hosted allocator changed; review the P4 PSRAM compatibility layer")
            endif()
            string(SUBSTRING "${original}" 0 ${first} prefix)
            string(SUBSTRING "${original}" ${last} -1 suffix)
            set(generated "${CMAKE_CURRENT_BINARY_DIR}/compat/port_esp_hosted_host_os.c")
            file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/compat")
            file(WRITE "${generated}" "${prefix}void *hosted_malloc_align(size_t size, size_t align);\n\n${suffix}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
            list(APPEND updated "${generated}")
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one ESP-Hosted OS port; review the P4 PSRAM compatibility layer")
    endif()
    set_property(TARGET ${hosted_target} PROPERTY SOURCES "${updated}")
endfunction()
